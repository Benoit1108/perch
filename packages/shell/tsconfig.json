{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // Aucun type ambiant automatique : l'extension tourne sous GJS, pas sous Node.
